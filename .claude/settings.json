{
  "permissions": {
    "allow": [
      "Read",
      "WebFetch",
      "Web Search",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(ls *)",
      "Bash(python *)",
      "Bash(pytest *)",
      "Bash(pre-commit *)"
    ],
    "deny": [],
    "defaultMode": "auto"
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": true,
    "caveman@caveman": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "effortLevel": "high",
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "theme": "dark",
  "editorMode": "normal",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "env": {
    "CLAUDE_CODE_SCROLL_SPEED": "2"
  }
}
